# Router package env — see root .env.example for the full Singularity config.
# These vars are loaded from the repo-root .env by scripts/launch.sh.

# OpenRouter (primary — all models)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Legacy alias (optional — same value as OPENROUTER_API_KEY)
# TOKENROUTER_API_KEY=
# TOKENROUTER_BASE_URL=https://openrouter.ai/api/v1

SINGULARITY_DECISION_MODEL=deepseek/deepseek-v4-flash-0731
SINGULARITY_DECISION_TIMEOUT_MS=5000
# SINGULARITY_LLM_ROUTER=1
