# Copy to .env and fill in (never commit .env)
#
# Security: if .env was ever shared or committed, rotate all API keys immediately.

# GitHub API token for VS Code built-in extension downloads during `npm start`.
# Optional if `gh auth login` is configured — launch.sh falls back to `gh auth token`.
# GITHUB_TOKEN=

# --- Primary provider: OpenRouter (all models) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Legacy alias — optional; same value as OPENROUTER_API_KEY
# TOKENROUTER_API_KEY=
# TOKENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Router decision/context models (specialty classifier, flash/pro lane)
# SINGULARITY_DECISION_API_KEY=          # defaults to OPENROUTER_API_KEY
# SINGULARITY_DECISION_BASE_URL=https://openrouter.ai/api/v1
SINGULARITY_DECISION_MODEL=deepseek/deepseek-v4-flash-0731
SINGULARITY_DECISION_TIMEOUT_MS=5000

# Neural Relay — tight context for maximum DeepSeek cache reuse
NEURAL_RELAY_MODEL=nvidia/nemotron-3-nano-30b-a3b:free
NEURAL_RELAY_CONFIDENCE_HIGH=0.65
NEURAL_RELAY_CONFIDENCE_LOW=0.25
NEURAL_RELAY_MAX_FILES=8
SINGULARITY_CONTEXT_WAIT_MS=22000

# Context Engine (LangExtract) — enabled by default for all chat/agent modes
SINGULARITY_CONTEXT_ENGINE=true
SINGULARITY_LANGEXTRACT_ENABLED=true
SINGULARITY_CONTEXT_RETRIEVAL_ENABLED=true
SINGULARITY_CONTEXT_AGENT_INTEGRATION_ENABLED=true
SINGULARITY_CONTEXT_DEBUG=1
SINGULARITY_LANGEXTRACT_TIMEOUT_MS=30000

# LLM Wiki (Karpathy pattern) — persistent compounding knowledge base
SINGULARITY_WIKI=true
SINGULARITY_WIKI_AGENT_INTEGRATION=true
SINGULARITY_WIKI_ROOT=.singularity/wiki

# Architecture Intelligence — async ADR memory (never on the coding LLM path)
ARCHITECTURE_MEMORY_ENABLED=true
ADR_EXTRACTION_ENABLED=true
ARCHITECTURE_GRAPH_ENABLED=true
ARCHITECTURE_VECTOR_SEARCH_ENABLED=true
ARCHITECTURE_CONTEXT_ENABLED=true
ARCHITECTURE_DRIFT_DETECTION_ENABLED=true
ARCHITECTURE_CONFLICT_DETECTION_ENABLED=true
ARCHITECTURE_EVOLUTION_ENABLED=true

# Memory Engine — async project memory (never on the coding LLM path)
MEMORY_ENGINE_ENABLED=true
MEMORY_EXTRACTION_ENABLED=true
MEMORY_GRAPH_ENABLED=true
MEMORY_VECTOR_SEARCH_ENABLED=true
MEMORY_CONTEXT_ENABLED=true
MEMORY_LLM_MAX_CONCURRENCY=10
# Optional: PostgreSQL + pgvector (SQLite is the local default)
# MEMORY_DATABASE_URL=postgres://localhost:5432/singularity_memory
# Optional: Redis L2 cache / streams
# MEMORY_REDIS_URL=redis://127.0.0.1:6379
# Optional: Neo4j
# NEO4J_URI=bolt://127.0.0.1:7687
# Optional: Mem0
# MEM0_API_KEY=

# Context Engine (LangExtract) — uses the same OpenRouter Flash model
SINGULARITY_CONTEXT_PROVIDER=openai
SINGULARITY_CONTEXT_MODEL=deepseek/deepseek-v4-flash-0731
SINGULARITY_BRAIN_MODEL=deepseek/deepseek-v4-flash-0731
SINGULARITY_CONTEXT_BASE_URL=https://openrouter.ai/api/v1
SINGULARITY_CONTEXT_TEMPERATURE=0
SINGULARITY_CONTEXT_MAX_OUTPUT_TOKENS=4096
# Or Gemini: SINGULARITY_CONTEXT_PROVIDER=langextract + LANGEXTRACT_API_KEY=
# SINGULARITY_CONTEXT_PYTHON is auto-set by scripts/launch.sh to the sidecar venv
